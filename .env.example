# Copy to .env.local and fill in. Never commit real values.

# ── Supabase (required) ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Security (required in production) ────────────────────────────────────────
STAMP_QR_SECRET=          # long random string, e.g. `openssl rand -hex 32`
CRON_SECRET=              # long random string; Vercel Cron sends it as a Bearer token

# ── Demo logins (optional) ───────────────────────────────────────────────────
NEXT_PUBLIC_DEMO_PASSWORD=    # must match supabase/seed/demo_accounts.sql

# ── Email (optional; needed for email-OTP verification in production) ────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=Studeals
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Optional dedicated secrets (fall back to SUPABASE_SERVICE_ROLE_KEY) ──────
OTP_HMAC_SECRET=
STAFF_SESSION_SECRET=

# ── Stripe (optional — without a key billing runs in demo mode) ──────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_GROWTH_PRICE_ID=
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=
NEXT_PUBLIC_STRIPE_GROWTH_ANNUAL_PRICE_ID=
NEXT_PUBLIC_STRIPE_PRO_ANNUAL_PRICE_ID=
